# 复制为 deploy.env 后修改（deploy.env 不会提交到 git）
DEPLOY_HOST=kylebing.cn
DEPLOY_USER=root
DEPLOY_PATH=/var/www/html/portal-go

# 上传后远程重启服务（0=不重启）
DEPLOY_RESTART=1
# 空格分隔的多个 systemd 服务名
DEPLOY_SERVICES="portal-go portal-ws"

# 是否一并构建并同步 manager 前端到 portal-go（nginx /manager/ 已反代到这里）
DEPLOY_FRONTEND=1

# 生产机 systemd 建议：Environment=ALLOW_SETUP=0（禁用 /setup /init 写操作）
# ALLOW_SETUP=0
