# 复制为 deploy.env 后修改（deploy.env 不会提交到 git）
DEPLOY_HOST=kylebing.cn
DEPLOY_USER=root
DEPLOY_PATH=/var/www/html/portal-go

# 上传后远程重启服务（0=不重启）
DEPLOY_RESTART=1
# 空格分隔的多个 systemd 服务名
DEPLOY_SERVICES="portal-go portal-ws"

# 是否一并构建并同步 manager 前端到 portal-go（nginx /manager/ 已反代到这里）
DEPLOY_FRONTEND=1

# JWT 鉴权密钥（portal / ws 进程均需配置，建议写进 systemd Environment）
# JWT_SECRET=change-me-to-a-long-random-string

# 对外可访问的 API 根地址（邮件验证/重置链接用，勿尾斜杠）
# APP_PUBLIC_URL=https://kylebing.cn/portal

# 阿里云邮件推送 DirectMail（未配置时验证/重置邮件走 stub 日志，本地开发可用）
# ALIYUN_DM_ACCESS_KEY_ID=
# ALIYUN_DM_ACCESS_KEY_SECRET=
# ALIYUN_DM_ACCOUNT_NAME=noreply@mail.yourdomain
# ALIYUN_DM_REGION=cn-hangzhou
# ALIYUN_DM_FROM_ALIAS=日记
# MAIL_LOGO_URL=https://kylebing.cn/diary/favicon.png

# 生产机 systemd 建议：Environment=ALLOW_SETUP=0（禁用 /setup /init 写操作）
# ALLOW_SETUP=0
